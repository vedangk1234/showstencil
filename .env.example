# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                    # generate with: openssl rand -base64 32

# Google OAuth (YouTube scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube API
YOUTUBE_API_KEY=                    # for public Data API calls (no auth needed)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never expose to client

# Anthropic (Claude API for digest generation)
ANTHROPIC_API_KEY=

# PayPal (payments)
PAYPAL_CLIENT_ID=                  # from developer.paypal.com → My Apps & Credentials
PAYPAL_SECRET=                     # from developer.paypal.com → My Apps & Credentials
PAYPAL_MODE=live                   # REQUIRED. Canonical values: 'live' | 'sandbox' — no other value is valid (boot fails on anything else). Use 'sandbox' for dev, 'live' for production.
PAYPAL_STARTER_PLAN_ID=            # from scripts/create-paypal-plans.ts output
PAYPAL_PRO_PLAN_ID=                # from scripts/create-paypal-plans.ts output
PAYPAL_WEBHOOK_ID=                 # from developer.paypal.com → My Apps → Webhooks

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=digest@showstencil.com
SUPPORT_EMAIL=support@showstencil.com

# Gemini (thumbnail generation via Google GenAI)
GEMINI_API_KEY=

# Vercel cron secret (prevent external calls to cron endpoints)
CRON_SECRET=                        # generate with: openssl rand -base64 32

# Sentry (error monitoring — optional, app starts without it)
# Get DSN from sentry.io dashboard → Project → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Sentry org and project slugs from sentry.io
SENTRY_ORG=
SENTRY_PROJECT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
